# Host port to publish the web service on (change if 8000 is already in use)
WEB_PORT=8000

DJANGO_SECRET_KEY=changeme
# Hostnames/IPs you'll actually access Spool through - e.g. localhost,spool.example.com
DJANGO_ALLOWED_HOSTS=localhost,spool.local
# Required if DJANGO_ALLOWED_HOSTS is anything other than localhost/127.0.0.1 and
# you're serving over HTTPS behind a reverse proxy - e.g. https://spool.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
DEBUG=False
DATABASE_URL=postgres://spool:changeme@db:5432/spool
DB_PASSWORD=changeme
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# First-run only: the web service creates this account + profile automatically
# on startup if no profile exists yet. Leave ADMIN_PASSWORD blank to skip and
# create one yourself later with `docker compose exec web python manage.py
# createsuperuser` (you'd still need to attach a Profile via the Django shell -
# see the README).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
ADMIN_DISPLAY_NAME=Admin

# Optional - only needed if you want to connect Trakt/Simkl import. See the
# README for how to register an app and what redirect URI to use.
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
SIMKL_CLIENT_ID=
SIMKL_CLIENT_SECRET=
# Declared for future poster/metadata lookup - nothing in the app reads this
# yet, so it's safe to leave blank.
TMDB_API_KEY=
TIME_ZONE=Europe/Ljubljana
