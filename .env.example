# Host port to publish the web service on (change if 8000 is already in use)
WEB_PORT=8000
# gunicorn worker processes / threads per worker - raise GUNICORN_WORKERS
# on beefier hardware (roughly 2-4 per CPU core is a common starting
# point). Threads let one worker keep serving requests while another of
# its own requests is blocked on an external call (TMDB/Trakt/Simkl/
# Gemini) instead of tying up a whole worker for that call's latency.
GUNICORN_WORKERS=3
GUNICORN_THREADS=2

DJANGO_SECRET_KEY=changeme
# Hostnames/IPs you'll actually access Spool through - e.g. localhost,spool.example.com
DJANGO_ALLOWED_HOSTS=localhost,spool.local
# Required if DJANGO_ALLOWED_HOSTS is anything other than localhost/127.0.0.1 and
# you're serving over HTTPS behind a reverse proxy - e.g. https://spool.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
DEBUG=False
DATABASE_URL=postgres://spool:changeme@db:5432/spool
DB_PASSWORD=changeme
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
# Separate DB index from the above - caches TMDB discovery results
# (Movies & TV / Anime pages) across gunicorn's worker processes.
CACHE_URL=redis://redis:6379/2

# First-run only: the web service creates this account + profile automatically
# on startup if no profile exists yet. Leave ADMIN_PASSWORD blank to skip and
# create one yourself later with `docker compose exec web python manage.py
# createsuperuser` (you'd still need to attach a Profile via the Django shell -
# see docs/QUICKSTART.md).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
ADMIN_DISPLAY_NAME=Admin

# Optional - only needed if you want to connect Trakt/Simkl import. See the
# docs/IMPORTING.md for how to register an app and what redirect URI to use.
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
SIMKL_CLIENT_ID=
SIMKL_CLIENT_SECRET=
# Optional - a free v3 API key from themoviedb.org enables poster lookup
# for titles created via Trakt/Simkl sync or CSV import. Safe to leave
# blank (titles just keep the gradient-placeholder fallback).
TMDB_API_KEY=
# Optional - a free mdblist.com API key (mdblist.com/api) adds IMDb/Rotten
# Tomatoes/Metacritic/etc rating pills to a title's page alongside the TMDB
# rating. Safe to leave blank (TMDB rating only).
MDBLIST_API_KEY=
TIME_ZONE=Europe/Ljubljana

# Optional hardening - all default to off so upgrading never silently
# breaks a plain-HTTP/LAN-only setup. Turn these on once Spool is only
# ever reached over HTTPS (either terminated by a reverse proxy in front
# of it, or directly) - see docs/CONFIGURATION.md and SECURITY.md.
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
